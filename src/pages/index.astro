---
import { TOOL_GROUPS, TOOLS } from "../lib/conversion-utils";

const categoryIcons: Record<string, string> = {
  "pdf-to-word": "T",
  "pdf-to-powerpoint": "P",
  "compress-pdf": "↓",
  "merge-pdf": "+",
  "split-pdf": "÷",
  "pdf-to-images": "▧",
  "word-to-pdf": "W",
  "word-to-powerpoint": "P",
  "powerpoint-to-word": "W",
  "powerpoint-to-pdf": "P",
  "images-to-pdf": "▧",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Convert, organise and export PDF, Word, PowerPoint and image files in your browser. Your files stay on your device."
    />
    <meta name="theme-color" content="#f5f7f5" />
    <meta
      property="og:title"
      content="Scriptorium — Document tools, with care."
    />
    <meta
      property="og:description"
      content="Practical PDF, Word and PowerPoint tools. Process documents directly in your browser—no file uploads."
    />
    <title>Scriptorium — Document tools, with care</title>
  </head>
  <body>
    <header class="topbar">
      <a class="wordmark" href="#home" aria-label="Scriptorium home">
        <span class="brand-mark" aria-hidden="true">
          s
        </span>
        <span>scriptorium</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#workspace">Tools</a>
        <a href="#how-it-works">How it works</a>
        <a href="#privacy">Privacy</a>
      </nav>
      <a class="header-button" href="#workspace">
        Open the workspace
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 8h10M8 3l5 5-5 5" />
        </svg>
      </a>
    </header>

    <main id="home">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="eyebrow-dot"></span> A better place to get documents
            done
          </p>
          <h1 id="hero-title">
            Document work,
            <br />
            <em>made simpler.</em>
          </h1>
          <p class="hero-summary">
            Convert, combine and organise PDFs, Word documents, presentations
            and images in one straightforward workspace.
          </p>
          <div class="hero-actions">
            <a class="primary-button" href="#workspace">
              Explore document tools
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 8h10M8 3l5 5-5 5" />
              </svg>
            </a>
            <span class="hero-note">
              No sign-up. Files are processed in your browser.
            </span>
          </div>
          <div class="hero-proof" aria-label="Service details">
            <span>
              <span class="proof-icon">✓</span> Files stay on your device
            </span>
            <span>
              <span class="proof-icon">✓</span> No account required
            </span>
            <span>
              <span class="proof-icon">✓</span> Free to use
            </span>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="visual-glow"></div>
          <div class="visual-card document-back">
            <span class="doc-label">PRESENTATION</span>
            <span class="doc-heading"></span>
            <span class="doc-line"></span>
            <span class="doc-line short"></span>
            <span class="doc-block"></span>
          </div>
          <div class="visual-card document-front">
            <div class="doc-toolbar">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="doc-paper">
              <span class="doc-label">QUARTERLY REPORT</span>
              <span class="doc-heading"></span>
              <span class="doc-line"></span>
              <span class="doc-line"></span>
              <span class="doc-line short"></span>
              <span class="doc-chart">
                <i></i>
                <i></i>
                <i></i>
                <i></i>
                <i></i>
                <i></i>
                <i></i>
              </span>
              <span class="doc-line"></span>
              <span class="doc-line short"></span>
            </div>
          </div>
          <span class="file-chip chip-pdf">
            <span>PDF</span> Final-report.pdf
          </span>
          <span class="file-chip chip-docx">
            <span>DOCX</span> Edited-report.docx
          </span>
          <span class="visual-caption">
            One calm workspace. Your files stay yours.
          </span>
        </div>
      </section>

      <section
        class="workspace-section"
        id="workspace"
        aria-labelledby="workspace-section-title"
      >
        <div class="workspace-heading">
          <div>
            <p class="eyebrow section-eyebrow">THE SCRIPTORIUM WORKSPACE</p>
            <h2 id="workspace-section-title">What would you like to do?</h2>
            <p class="workspace-intro">
              Choose a tool, add your file and download the result.
            </p>
          </div>
          <span class="local-badge">
            <span></span> Files stay on your device
          </span>
        </div>

        <div class="workspace-shell">
          <aside class="tool-sidebar" aria-label="Choose a document tool">
            {TOOL_GROUPS.map((group) => (
              <section
                class="tool-group"
                aria-labelledby={`group-${group.name.toLowerCase().replaceAll(" ", "-")}`}
              >
                <h3
                  id={`group-${group.name.toLowerCase().replaceAll(" ", "-")}`}
                >
                  {group.name}
                </h3>
                <div class="tool-list">
                  {group.ids.map((id) => {
                    const tool = TOOLS[id];
                    return (
                      <button
                        type="button"
                        class={`tool-option${id === "pdf-to-word" ? " selected" : ""}`}
                        data-tool={id}
                        aria-pressed={id === "pdf-to-word" ? "true" : "false"}
                      >
                        <span class="tool-icon" aria-hidden="true">
                          {categoryIcons[id]}
                        </span>
                        <span class="tool-name">{tool.title}</span>
                        <svg
                          class="tool-arrow"
                          viewBox="0 0 16 16"
                          aria-hidden="true"
                        >
                          <path d="M3 8h10M8 3l5 5-5 5" />
                        </svg>
                      </button>
                    );
                  })}
                </div>
              </section>
            ))}
          </aside>

          <section class="work-area" aria-labelledby="workspace-title">
            <div class="work-heading">
              <div>
                <p class="work-kicker">YOUR SELECTED TOOL</p>
                <h3 id="workspace-title">PDF to Word</h3>
                <p id="workspace-description" class="work-description"></p>
              </div>
              <span class="format-badge">
                OUTPUT <strong id="output-format">DOCX</strong>
              </span>
            </div>

            <div class="file-stage">
              <div
                class="drop-zone"
                id="drop-zone"
                role="group"
                tabindex="0"
                aria-label="Add a document to convert"
                aria-describedby="drop-help"
              >
                <input
                  class="visually-hidden"
                  type="file"
                  id="file-input"
                  aria-label="Choose a document"
                />
                <span class="upload-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 15.5v3A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5v-3" />
                  </svg>
                </span>
                <h4 id="drop-title">Add .pdf files</h4>
                <p id="drop-help">Up to 1 file · 30 MB maximum per file</p>
                <button class="choose-button" id="select-files" type="button">
                  Choose file
                </button>
                <p class="drop-support">or drag and drop here</p>
              </div>
              <div class="privacy-strip">
                <svg viewBox="0 0 18 18" aria-hidden="true">
                  <path d="M9 2 3.5 4v4.3c0 3.3 2.2 6.2 5.5 7.7 3.3-1.5 5.5-4.4 5.5-7.7V4L9 2Z" />
                  <path d="m6.7 8.9 1.5 1.5 3.2-3.3" />
                </svg>
                Your documents stay on this device. They are never uploaded.
              </div>

              <ul class="file-list" id="file-list" aria-live="polite"></ul>

              <div class="tool-settings" id="range-options" hidden>
                <label for="page-range">Pages to extract</label>
                <input
                  type="text"
                  id="page-range"
                  value="1-3"
                  inputmode="numeric"
                  placeholder="For example: 1-3, 5"
                  aria-describedby="range-help"
                />
                <p id="range-help">
                  Enter page numbers or ascending ranges, such as 1-3, 5.
                </p>
              </div>

              <fieldset
                class="tool-settings compression-options"
                id="compression-options"
                hidden
              >
                <legend>Compression quality</legend>
                <div class="quality-choices">
                  <label>
                    <input
                      type="radio"
                      name="compression-quality"
                      value="standard"
                    />{" "}
                    Best clarity
                  </label>
                  <label>
                    <input
                      type="radio"
                      name="compression-quality"
                      value="balanced"
                      checked
                    />{" "}
                    Balanced
                  </label>
                  <label>
                    <input
                      type="radio"
                      name="compression-quality"
                      value="compact"
                    />{" "}
                    Smaller file
                  </label>
                </div>
                <p class="raster-warning">
                  Compression converts pages into images. Text, links, forms and
                  accessibility features are removed.
                </p>
                <label class="confirmation">
                  <input type="checkbox" id="compression-confirmation" />I
                  understand the compressed PDF will not have selectable text.
                </label>
              </fieldset>

              <p class="conversion-detail" id="conversion-detail"></p>
              <div class="conversion-controls">
                <button
                  class="convert-button"
                  id="run-conversion"
                  type="button"
                >
                  Convert to DOCX
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3 8h10M8 3l5 5-5 5" />
                  </svg>
                </button>
                <span class="supported-format">
                  Accepts <strong id="input-label">.pdf</strong>
                </span>
              </div>
              <div class="progress-area">
                <progress
                  id="progress-bar"
                  max="100"
                  value="0"
                  aria-label="Conversion progress"
                ></progress>
                <span id="progress-label">Files stay on this device</span>
              </div>
              <p
                class="workspace-status"
                id="workspace-status"
                role="status"
                aria-live="polite"
              ></p>
              <section
                class="conversion-results"
                id="conversion-results"
                aria-label="Conversion result"
                hidden
              ></section>
            </div>
          </section>
        </div>
        <p class="workspace-limits">
          Each file is limited to 30 MB and all selected files together to 80
          MB. PDF text extraction does not include OCR.
        </p>
      </section>

      <section
        class="how-section"
        id="how-it-works"
        aria-labelledby="how-title"
      >
        <div class="how-intro">
          <p class="eyebrow section-eyebrow">STRAIGHTFORWARD BY DESIGN</p>
          <h2 id="how-title">
            From file to finished.
            <br />
            <em>Without the fuss.</em>
          </h2>
          <p>
            Skip the account, complicated settings and unnecessary wait. Use a
            tool and get back to your work.
          </p>
        </div>
        <div class="steps">
          <article class="step">
            <span class="step-number">01</span>
            <h3>Choose a tool</h3>
            <p>
              Select the conversion or PDF task you need. Format requirements
              and limits are clearly listed.
            </p>
          </article>
          <article class="step">
            <span class="step-number">02</span>
            <h3>Add your document</h3>
            <p>
              Select a file from your device. It stays in your browser
              throughout processing.
            </p>
          </article>
          <article class="step">
            <span class="step-number">03</span>
            <h3>Download the result</h3>
            <p>
              Check the conversion note, download the new file and keep the
              original as a backup.
            </p>
          </article>
        </div>
      </section>

      <section
        class="privacy-section"
        id="privacy"
        aria-labelledby="privacy-title"
      >
        <div class="privacy-lock" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M6.5 10V7.5a5.5 5.5 0 0 1 11 0V10M5.5 10h13v11h-13zM12 14v3" />
          </svg>
        </div>
        <div class="privacy-copy">
          <p class="eyebrow">YOUR DOCUMENTS ARE PERSONAL</p>
          <h2 id="privacy-title">Private by default.</h2>
          <p>
            Scriptorium runs document processing in your browser. Your files are
            not sent to our server because there is no document-processing
            server.
          </p>
        </div>
        <div class="privacy-facts">
          <span>
            <i>01</i> Files are processed on your device
          </span>
          <span>
            <i>02</i> No account or file upload
          </span>
          <span>
            <i>03</i> Your original stays unchanged
          </span>
        </div>
      </section>
    </main>

    <footer class="footer">
      <a class="wordmark" href="#home">
        <span class="brand-mark" aria-hidden="true">
          s
        </span>
        <span>scriptorium</span>
      </a>
      <span class="footer-note">
        Considered document tools. No uploads, no account.
      </span>
      <a class="back-to-top" href="#home">
        Back to top <span aria-hidden="true">↑</span>
      </a>
      <span class="copyright">© {new Date().getFullYear()} Scriptorium</span>
    </footer>
  </body>
</html>

<script>
  import "../scripts/workspace";
</script>

<style>
  :root {
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    color: #23332d;
    background: #fff;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    --ink: #23332d;
    --muted: #77827d;
    --green: #27765f;
    --green-dark: #205e4c;
    --green-light: #edf5f0;
    --line: #e8ede8;
    --soft: #f5f7f5;
    --white: #fff;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 85px;
  }

  body {
    margin: 0;
    min-width: 0;
    background: #fff;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input {
    font: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  button:focus-visible,
  a:focus-visible,
  [tabindex]:focus-visible,
  input:focus-visible {
    outline: 3px solid #70ae93;
    outline-offset: 3px;
  }

  .topbar,
  .footer {
    display: flex;
    align-items: center;
    max-width: 1280px;
    margin: 0 auto;
    padding: 18px 56px;
  }

  .topbar {
    justify-content: space-between;
    min-height: 76px;
    background: #fff;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .brand-mark {
    display: grid;
    width: 31px;
    height: 31px;
    place-items: center;
    border-radius: 9px;
    background: var(--green);
    color: #fff;
    font-family: Georgia, serif;
    font-size: 22px;
    font-weight: 400;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 34px;
    color: #56665e;
    font-size: 12px;
  }

  nav a,
  .back-to-top {
    transition: color 150ms ease;
  }

  nav a:hover,
  .back-to-top:hover {
    color: var(--green);
  }

  .header-button,
  .primary-button,
  .convert-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    border: 0;
    border-radius: 5px;
    background: var(--green);
    color: #fff;
    font-weight: 650;
    transition:
      background 150ms ease,
      transform 150ms ease;
  }

  .header-button {
    padding: 11px 15px;
    font-size: 11px;
  }

  .header-button:hover,
  .primary-button:hover,
  .convert-button:hover:not(:disabled) {
    transform: translateY(-1px);
    background: var(--green-dark);
  }

  .header-button svg,
  .primary-button svg,
  .convert-button svg,
  .tool-arrow {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    align-items: center;
    gap: 36px;
    max-width: 1280px;
    min-height: 498px;
    margin: 0 auto;
    padding: 48px 56px 66px;
    overflow: hidden;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    padding: 4px 0 0;
  }

  .eyebrow {
    margin: 0;
    color: var(--green);
    font-size: 9px;
    font-weight: 750;
    letter-spacing: 1.55px;
    line-height: 1.5;
  }

  .hero-copy > .eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #64746a;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15px;
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 7px;
    border-radius: 50%;
    background: #62a77d;
    box-shadow: 0 0 0 4px #62a77d20;
  }

  h1,
  h2,
  h3,
  h4,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: -2px;
  }

  h1 {
    max-width: 650px;
    margin: 21px 0 17px;
    font-size: clamp(46px, 5.5vw, 68px);
    line-height: 1.045;
  }

  h1 em,
  .how-intro h2 em {
    color: var(--green);
    font-weight: 400;
  }

  .hero-summary {
    max-width: 482px;
    margin-bottom: 23px;
    color: #697670;
    font-size: 14px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .primary-button {
    min-height: 45px;
    padding: 0 16px;
    font-size: 11px;
  }

  .hero-note {
    margin: 0;
    color: #858f89;
    font-size: 10px;
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 22px;
    margin-top: 33px;
    color: #586860;
    font-size: 10px;
  }

  .proof-icon {
    display: inline-grid;
    width: 15px;
    height: 15px;
    margin-right: 5px;
    place-items: center;
    border: 1px solid #cfe0d4;
    border-radius: 50%;
    color: #398063;
    font-size: 9px;
  }

  .hero-visual {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 365px;
    place-items: center;
  }

  .visual-glow {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #e6f0e9 0,
      #f1f5ef 56%,
      #f7f8f4 74%,
      transparent 75%
    );
  }

  .visual-card {
    position: absolute;
    width: 222px;
    height: 278px;
    overflow: hidden;
    border: 1px solid #e6ebe4;
    border-radius: 8px;
    box-shadow: 0 18px 55px #18352b13;
  }

  .document-back {
    z-index: 1;
    padding: 24px;
    transform: translate(47px, 5px) rotate(7deg);
    background: #f2f4ec;
  }

  .document-front {
    z-index: 2;
    transform: translate(-18px, 4px) rotate(-4deg);
    background: #fff;
  }

  .doc-toolbar {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 23px;
    padding: 0 9px;
    border-bottom: 1px solid #edf0eb;
    background: #fbfcfa;
  }

  .doc-toolbar span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ccd9cb;
  }

  .doc-paper {
    padding: 21px 23px;
  }

  .doc-label {
    display: block;
    margin-bottom: 23px;
    color: #7d8c7d;
    font-size: 6px;
    font-weight: 750;
    letter-spacing: 1.1px;
  }

  .doc-heading,
  .doc-line {
    display: block;
    width: 100%;
    height: 4px;
    margin-bottom: 8px;
    border-radius: 4px;
    background: #e7ebe4;
  }

  .doc-heading {
    width: 78%;
    height: 7px;
    margin-bottom: 13px;
    background: #47745b;
  }

  .doc-line.short {
    width: 58%;
  }

  .doc-chart {
    display: flex;
    align-items: end;
    gap: 5px;
    height: 67px;
    margin: 16px 0;
    padding: 10px;
    border: 1px solid #eff1eb;
    border-radius: 4px;
    background: #f8faf6;
  }

  .doc-chart i {
    flex: 1;
    border-radius: 2px 2px 0 0;
    background: #8eb29a;
  }

  .doc-chart i:nth-child(1),
  .doc-chart i:nth-child(5) {
    height: 38%;
  }

  .doc-chart i:nth-child(2),
  .doc-chart i:nth-child(7) {
    height: 60%;
  }

  .doc-chart i:nth-child(3),
  .doc-chart i:nth-child(6) {
    height: 48%;
  }

  .doc-chart i:nth-child(4) {
    height: 83%;
    background: #4a8061;
  }

  .document-back .doc-label {
    margin-bottom: 34px;
  }

  .document-back .doc-block {
    display: block;
    width: 100%;
    height: 87px;
    margin-top: 18px;
    border-radius: 5px;
    background: linear-gradient(135deg, #dce8da 0 48%, #e8ede1 48%);
  }

  .file-chip {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 11px 8px 8px;
    border: 1px solid #e7ece7;
    border-radius: 6px;
    background: #fff;
    box-shadow: 0 6px 24px #1c37280c;
    color: #58675e;
    font-size: 8px;
  }

  .file-chip > span {
    padding: 5px 5px;
    border-radius: 3px;
    background: #edf4ed;
    color: #3b7756;
    font-size: 7px;
    font-weight: 800;
  }

  .chip-pdf {
    top: 65px;
    right: -1px;
  }

  .chip-docx {
    bottom: 59px;
    left: -9px;
